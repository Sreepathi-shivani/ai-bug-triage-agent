# --- Jira ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug

# --- LLM (Anthropic) used to triage failures and set priority ---
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Dedup ---
# Local file used to remember which failures were already filed, so reruns
# of the same failing test don't create duplicate Jira tickets.
DEDUP_STORE_PATH=.filed_bugs.json
